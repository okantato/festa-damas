# App id do Base44. Obrigatório para persistir convites e RSVP.
# Onde configurar na Vercel: Project > Settings > Environment Variables.
# Sem esse valor o app sobe em modo local (localStorage) e nada é salvo no Base44.
VITE_BASE44_APP_ID=""

# URL pública do app (ex.: https://festa-da-menina.vercel.app).
# Usada nos links de convite e nos modelos de WhatsApp.
VITE_APP_BASE_URL=""

# Versão das functions do Base44. Opcional: deixe vazio para usar a versão publicada.
VITE_BASE44_FUNCTIONS_VERSION=""
